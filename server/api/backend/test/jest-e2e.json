{
   "moduleFileExtensions": ["js", "json", "ts"],
   "rootDir": "..",
   "testRegex": "test/features/.*\\.e2e-spec\\.ts$",
   "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
   },
   "transformIgnorePatterns": [
      "node_modules/(?!(@noble)/)"
   ],
   "testEnvironment": "node",
   "preset": "ts-jest",
   "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "^uuid$": "<rootDir>/test/setup/uuid-shim.ts",
      "^firebase-admin/(app|auth)$": "<rootDir>/test/setup/firebase-admin-shim.ts"
   },
   "testTimeout": 60000
}
